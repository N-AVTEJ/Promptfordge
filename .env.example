# ==============================================================================
# PromptForge Environment Configuration
# ==============================================================================
# Server-side only: never expose provider secrets to client bundles.
# Client-accessible variables MUST be explicitly prefixed with NEXT_PUBLIC_.

# ------------------------------------------------------------------------------
# 1. Primary AI Providers
# ------------------------------------------------------------------------------
# Google Gemini API Key (Primary Provider for Flash, Pro, and 2.0)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Secondary Provider for GPT-4o and GPT-4o Mini)
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 2. Safety & Operational Hard Stops
# ------------------------------------------------------------------------------
# Global Kill Switch: Set to "true" to immediately halt all external LLM API calls.
# When active, labs and API routes fall back to pre-recorded cached demo data.
PROMPTFORGE_KILL_SWITCH=false

# Client-level demo mode toggle
NEXT_PUBLIC_DEMO_MODE=false

# Global daily token hard stop budget (resets at 00:00 UTC)
PROMPTFORGE_DAILY_TOKEN_BUDGET=500000

# Per-IP rate limit quota within a sliding 1-hour window
PROMPTFORGE_RATE_LIMIT_PER_HOUR=20

# Payload character boundaries
PROMPTFORGE_MAX_PROMPT_LENGTH=12000
PROMPTFORGE_MAX_OUTPUT_TOKENS=4096

# In-memory LRU cache configuration
PROMPTFORGE_CACHE_MAX_ENTRIES=500
PROMPTFORGE_CACHE_TTL_MS=86400000
